---
import Base from '../../layouts/Base.astro';
import { languages } from '../../i18n/config.js';
import { getTranslations } from '../../i18n/utils.js';
import { shops as shopData } from '../../data/shops.js';

export async function getStaticPaths() {
  return Object.keys(languages).map(code => ({
    params: { lang: code },
    props: { lang: code },
  }));
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const values = [
  { icon: '💫', title: t.values.esteemTitle, text: t.values.esteemText },
  { icon: '📖', title: t.values.sharingTitle, text: t.values.sharingText },
  { icon: '🎯', title: t.values.targetedTitle, text: t.values.targetedText },
  { icon: '⚡', title: t.values.cuttingEdgeTitle, text: t.values.cuttingEdgeText },
  { icon: '🕊️', title: t.values.nonviolenceTitle, text: t.values.nonviolenceText },
  { icon: 'Freedom', title: t.values.independenceTitle, text: t.values.independenceText },
  { icon: '🔍', title: t.values.transparencyTitle, text: t.values.transparencyText },
];

const projects = [
  { img: '/images/wwfp-04.jpg', title: t.whatWeDo.project1Title, text: t.whatWeDo.project1Text },
  { img: '/images/wwfp-06.jpg', title: t.whatWeDo.project2Title, text: t.whatWeDo.project2Text },
  { img: '/images/wwfp-07.jpg', title: t.whatWeDo.project3Title, text: t.whatWeDo.project3Text },
  { img: '/images/wwfp-09.jpg', title: t.whatWeDo.project4Title, text: t.whatWeDo.project4Text },
];
---

<Base lang={lang} t={t}>
  <!-- Hero -->
  <section id="top" class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-content">
      <h1 class="hero-title">{t.home.heroTitle}</h1>
      <p class="hero-subtitle">{t.home.heroSubtitle}</p>
      <div class="hero-actions">
        <a href={`/${lang}/support`} class="btn btn--primary hero-btn-primary">{t.home.heroCtaSecondary}</a>
        <a href="#get-involved" class="btn btn--primary hero-btn-toggle">{t.home.heroCta}</a>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="section">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-text">
          <h2>{t.home.introTitle}</h2>
          <p class="intro-lead">{t.home.introText}</p>
        </div>
        <div class="intro-image">
          <img src="/images/wwfp-01.jpg" alt="WWFP community" class="rounded-img" />
        </div>
      </div>
    </div>
  </section>

  <!-- What We Do (merged) -->
  <section id="what-we-do" class="section section--alt">
    <div class="container">
      <h2 class="text-center mb-md">{t.home.whatWeDoTitle}</h2>
      <p class="section-intro">{t.home.whatWeDoIntro}</p>
      <div class="card-grid">
        {projects.map(p => (
          <div class="card card--with-image">
            <img src={p.img} alt={p.title} class="card-img" />
            <div class="card-body">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          </div>
        ))}
      </div>
      <!-- Gallery strip -->
      <div class="gallery-strip">
        <img src="/images/wwfp-12.jpg" alt="WWFP in action" />
        <img src="/images/wwfp-13.jpg" alt="WWFP in action" />
        <img src="/images/wwfp-16.jpg" alt="WWFP in action" />
        <img src="/images/wwfp-18.jpg" alt="WWFP in action" />
        <img src="/images/wwfp-19.jpg" alt="WWFP in action" />
      </div>
    </div>
  </section>

  <!-- Values (merged) -->
  <section id="values" class="section">
    <div class="container">
      <h2 class="text-center mb-md">{t.home.valuesTitle}</h2>
      <p class="section-intro">{t.home.valuesIntro}</p>
      <div class="values-list">
        {values.map((v, i) => (
          <div class={i % 2 === 0 ? 'value-row' : 'value-row value-row--alt'}>
            <div class="value-icon">{v.icon}</div>
            <div class="value-content">
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Get Involved (merged) -->
  <section id="get-involved" class="section section--alt">
    <div class="container">
      <h2 class="text-center mb-md">{t.home.getInvolvedTitle}</h2>
      <p class="section-intro">{t.home.getInvolvedIntro}</p>
      <div class="membership-grid">
        <div class="card membership-card">
          <img src="/images/wwfp-14.jpg" alt="Passive member" class="card-img" />
          <div class="card-body">
            <h3>{t.home.passiveTitle}</h3>
            <p>{t.home.passiveText}</p>
            <ul class="check-list">
              <li>{t.getInvolved.passivePoint1}</li>
              <li>{t.getInvolved.passivePoint2}</li>
              <li>{t.getInvolved.passivePoint3}</li>
            </ul>
          </div>
        </div>
        <div class="card membership-card membership-card--active">
          <img src="/images/wwfp-15.jpg" alt="Active member" class="card-img" />
          <div class="card-body">
            <h3>{t.home.activeTitle}</h3>
            <p>{t.home.activeText}</p>
            <ul class="check-list">
              <li>{t.getInvolved.activePoint1}</li>
              <li>{t.getInvolved.activePoint2}</li>
              <li>{t.getInvolved.activePoint3}</li>
              <li>{t.getInvolved.activePoint4}</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="text-center mt-lg">
        <a href={`/${lang}/contact`} class="btn btn--primary">{t.getInvolved.cta}</a>
      </div>
    </div>
  </section>

  <!-- Hostel -->
  <section id="hostel" class="section section--hidden">
    <div class="container">
      <h2 class="text-center mb-md">{t.hostel.title}</h2>
      <p class="section-intro">{t.hostel.intro}</p>
      <div class="hostel-steps">
        <div class="hostel-step">
          <div class="step-number">1</div>
          <p>{t.hostel.step1}</p>
        </div>
        <div class="hostel-step">
          <div class="step-number">2</div>
          <p>{t.hostel.step2}</p>
        </div>
        <div class="hostel-step">
          <div class="step-number">3</div>
          <p>{t.hostel.step3}</p>
        </div>
        <div class="hostel-step">
          <div class="step-number">4</div>
          <p>{t.hostel.step4}</p>
        </div>
      </div>
      <div class="hostel-coming-soon card">
        <h3>📍 {t.hostel.comingSoon}</h3>
        <p>{t.hostel.comingSoonText}</p>
        <a href={`/${lang}/contact`} class="btn btn--secondary mt-md">{t.nav.contact}</a>
      </div>
    </div>
  </section>

  <!-- Shop -->
  <section id="shop" class="section section--alt">
    <div class="container">
      <h2 class="text-center mb-md">{t.shop.title}</h2>
      <p class="section-intro">{t.shop.intro}</p>

      <div class="shop-grid">
        {shopData.map(shop => (
          <a href={`/${lang}/shop/${shop.slug}`} class="shop-card">
            <div class="shop-card-img-wrap">
              <img src={shop.image} alt={`${shop.name} — ${shop.city}`} class="shop-card-img" />
              <div class="shop-card-overlay">
                <span class="shop-card-enter">{t.shop.enterShop || 'Enter shop →'}</span>
              </div>
            </div>
            <div class="shop-card-body">
              <h3>{shop.name}</h3>
              <p class="shop-card-location">📍 {shop.city}, {shop.country}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="shop-note card">
        <h3>🛍️ {t.shop.comingSoon}</h3>
        <p>{t.shop.comingSoonText}</p>
        <div class="shop-actions">
          <a href={`/${lang}/contact`} class="btn btn--primary">{t.shop.registerCta}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote / CTA -->
  <section class="section section--forest quote-section">
    <div class="quote-bg"></div>
    <div class="container text-center quote-content">
      <blockquote class="big-quote">
        "{t.footer.tagline}"
      </blockquote>
      <a href="#get-involved" class="btn btn--clay mt-md">{t.home.heroCta}</a>
    </div>
  </section>
</Base>

<style>
.hero {
  position: relative;
  min-height: 75vh;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
  background: transparent;
  padding-bottom: var(--space-xl);
}

.hero-bg {
  position: absolute;
  inset: 0;
  background-image: url('/images/wwfp-02.jpg');
  background-size: cover;
  background-position: center;
  z-index: 0;
}

.hero-content {
  position: relative;
  z-index: 1;
  padding: var(--space-xl) var(--space-md);
  text-align: center;
  width: 100%;
  max-width: 1200px;
}

.hero-title {
  font-size: 3.5rem;
  line-height: 1.15;
  max-width: 900px;
  margin: 0 auto var(--space-sm);
  background: linear-gradient(135deg, #00e5cc 0%, #00b4d8 40%, #48cae4 70%, #00e5cc 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.7));
}

.hero-subtitle {
  font-size: 1.3rem;
  font-style: italic;
  margin-bottom: var(--space-lg);
  background: linear-gradient(135deg, #90e0ef 0%, #48cae4 50%, #00b4d8 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.7));
}

.hero-actions {
  display: flex;
  gap: var(--space-xl);
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 4rem;
  margin-top: var(--space-lg);
}

.hero-actions .btn--primary {
  background: linear-gradient(135deg, #00b4d8 0%, #00e5cc 100%);
  color: #fff;
  border: 2px solid transparent;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
}

.hero-actions .btn--primary:hover {
  background: linear-gradient(135deg, #0096c7 0%, #00b4d8 100%);
  box-shadow: 0 4px 12px rgba(0, 180, 216, 0.4);
}

.hero-btn-toggle {
  background: linear-gradient(135deg, #00b4d8 0%, #00e5cc 100%);
  color: #fff;
  border: 2px solid #00b4d8;
}

.hero-btn-toggle:hover {
  background: transparent;
  color: #48cae4;
  border-color: #48cae4;
}

.section-intro {
  text-align: center;
  max-width: 700px;
  margin: 0 auto var(--space-lg);
  font-size: 1.1rem;
  color: var(--color-text-light);
}

.intro-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-lg);
  align-items: center;
  text-align: center;
}

.intro-lead {
  font-size: 1.15rem;
  color: var(--color-text-light);
  margin-bottom: var(--space-md);
}

.rounded-img {
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  width: 100%;
  object-fit: cover;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-md);
}

.card--with-image {
  padding: 0;
  overflow: hidden;
}

.card-img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

.card-body {
  padding: var(--space-md);
  text-align: center;
}

.gallery-strip {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}

.gallery-strip img {
  width: 100%;
  height: 160px;
  object-fit: cover;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  transition: transform var(--transition);
}

.gallery-strip img:hover {
  transform: scale(1.03);
}

/* Values */
.values-list {
  max-width: 800px;
  margin: 0 auto;
}

.value-row {
  display: flex;
  gap: var(--space-md);
  padding: var(--space-md) 0;
  border-bottom: 1px solid var(--color-border);
  align-items: flex-start;
}

.value-row--alt {
  flex-direction: row-reverse;
  text-align: right;
}

.value-icon {
  font-size: 2.5rem;
  min-width: 60px;
  text-align: center;
}

.value-content h3 {
  margin-bottom: 0.3rem;
}

/* Membership */
.membership-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-md);
  max-width: 800px;
  margin: 0 auto;
}

.membership-card {
  padding: 0;
  overflow: hidden;
  text-align: center;
}

.membership-card--active {
  border: 2px solid var(--color-forest);
}

.check-list {
  list-style: none;
  padding: 0;
  text-align: left;
  max-width: 300px;
  margin: var(--space-sm) auto 0;
}

.check-list li {
  padding: 0.4rem 0;
  padding-left: 1.8rem;
  position: relative;
}

.check-list li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--color-leaf);
  font-weight: bold;
}

/* Hostel */
.hostel-steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-md);
  max-width: 900px;
  margin: 0 auto var(--space-lg);
}

.hostel-step {
  text-align: center;
}

.step-number {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--color-forest);
  color: var(--color-cream);
  font-size: 1.5rem;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto var(--space-sm);
}

.hostel-coming-soon {
  max-width: 600px;
  margin: 0 auto;
  text-align: center;
  padding: var(--space-md);
}

.hostel-coming-soon h3 {
  margin-bottom: var(--space-sm);
}

/* Shop */
.shop-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--space-sm);
  max-width: 1200px;
  margin: 0 auto var(--space-lg);
}

.shop-card {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  color: inherit;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: rgba(255, 255, 255, 0.5);
  box-shadow: 0 2px 8px rgba(45, 32, 19, 0.06);
  transition: transform var(--transition), box-shadow var(--transition);
}

.shop-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
}

.shop-card-img-wrap {
  position: relative;
  overflow: hidden;
  aspect-ratio: 4/3;
}

.shop-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.shop-card:hover .shop-card-img {
  transform: scale(1.08);
}

.shop-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 50%, rgba(26, 58, 36, 0.7) 100%);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: var(--space-sm);
  opacity: 0;
  transition: opacity var(--transition);
}

.shop-card:hover .shop-card-overlay {
  opacity: 1;
}

.shop-card-enter {
  color: var(--color-cream);
  font-size: 0.95rem;
  font-weight: 600;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
}

.shop-card-body {
  padding: var(--space-sm);
  text-align: center;
}

.shop-card-body h3 {
  font-size: 1.1rem;
  margin-bottom: 0.2rem;
}

.shop-card-location {
  font-size: 0.85rem;
  color: var(--color-text-light);
  margin: 0;
}

.shop-note {
  max-width: 600px;
  margin: 0 auto;
  text-align: center;
  padding: var(--space-md);
}

.shop-note h3 {
  margin-bottom: var(--space-sm);
}

.shop-actions {
  margin-top: var(--space-md);
}

/* Quote */
.quote-section {
  position: relative;
  overflow: hidden;
}

.quote-bg {
  position: absolute;
  inset: 0;
  background-image: url('/images/wwfp-17.jpg');
  background-size: cover;
  background-position: center;
  opacity: 0.25;
}

.quote-content {
  position: relative;
  z-index: 1;
}

.big-quote {
  font-family: var(--font-head);
  font-size: 2rem;
  color: var(--color-forest-deep);
  font-style: italic;
  max-width: 700px;
  margin: 0 auto;
}

/* Smooth scroll for anchor links */
html {
  scroll-behavior: smooth;
}

/* Hidden sections (Hostel & Shop) */
.section--hidden {
  display: none;
}

.section--hidden.section--visible {
  display: block;
}

@media (max-width: 768px) {
  .hero-actions { flex-wrap: nowrap; padding: 0 1rem; }
  .hero-title { font-size: 2.2rem; }
  .hero-subtitle { font-size: 1.1rem; }
  .intro-grid { grid-template-columns: 1fr; }
  .card-grid { grid-template-columns: 1fr 1fr; }
  .membership-grid { grid-template-columns: 1fr; }
  .gallery-strip { grid-template-columns: repeat(2, 1fr); }
  .hostel-steps { grid-template-columns: 1fr 1fr; }
  .shop-grid { grid-template-columns: repeat(2, 1fr); }
  .big-quote { font-size: 1.4rem; }
  .card-img { height: 160px; }
  .value-row, .value-row--alt {
    flex-direction: column;
    text-align: left;
  }
}
</style>