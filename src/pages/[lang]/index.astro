  <script is:inline>
    (function() {
      var vid = document.getElementById('heroVideo');
      var btn = document.getElementById('playBtn');
      var replayBtn = document.getElementById('replayBtn');
      var poster = document.getElementById('heroPoster');
      var hlsLoaded = false;

      function loadHeroVideo(callback) {
        if (hlsLoaded) { callback(); return; }
        if (vid && vid.canPlayType('application/vnd.apple.mpegurl')) {
          vid.src = '/videos/about-us-hls/index.m3u8';
          hlsLoaded = true;
          callback();
        } else {
          var hs = document.createElement('script');
          hs.src = 'https://cdn.jsdelivr.net/npm/hls.js@1/dist/hls.min.js';
          hs.onload = function() {
            if (typeof Hls !== 'undefined' && Hls.isSupported()) {
              var hls = new Hls();
              hls.loadSource('/videos/about-us-hls/index.m3u8');
              hls.attachMedia(vid);
              hlsLoaded = true;
              callback();
            }
          };
          document.head.appendChild(hs);
        }
      }

      if (btn) {
        btn.addEventListener('click', function() {
          if (!vid) return;
          loadHeroVideo(function() {
            vid.muted = false;
            vid.loop = false;
            vid.play().catch(e => console.error("Playback failed", e));
            if (poster) poster.style.display = 'none';
            btn.style.display = 'none';
          });
        });
      }
      if (replayBtn) {
        replayBtn.addEventListener('click', function() {
          if (vid) {
            vid.currentTime = 0;
            vid.play().catch(e => console.error("Playback failed", e));
            if (poster) poster.style.display = 'none';
            replayBtn.style.display = 'none';
          }
        });
      }
      if (vid) {
        vid.addEventListener('ended', function() {
          vid.style.display = 'none';
          if (poster) poster.style.display = 'block';
          if (replayBtn) replayBtn.style.display = 'inline-block';
        });
      }

      function startTypewriter(elementId, text, loop = true) {
        const textElement = document.getElementById(elementId);
        if (!textElement) return;
        let charIndex = 0;
        let isDeleting = false;
        let typeSpeed = 150;
        function type() {
          const currentText = text.substring(0, charIndex);
          textElement.innerHTML = currentText + '<span class="cursor">|</span>';
          if (!isDeleting && charIndex < text.length) {
            charIndex++;
            typeSpeed = 150;
          } else if (isDeleting && charIndex > 0) {
            charIndex--;
            typeSpeed = 70;
          } else {
            if (!loop && isDeleting) return;
            isDeleting = !isDeleting;
            typeSpeed = isDeleting ? 1000 : 500;
          }
          setTimeout(type, typeSpeed);
        }
        type();
      }

      startTypewriter('typewriter', "WWFP · Identity", true);

      // R(e)volution — add glow after all letters appear
      (function() {
        var revLetters = document.querySelectorAll('.rev-letter, .rev-e');
        if (revLetters.length === 0) return;
        // Total animation time: last letter delay (1.65s) + letter duration (1.2s) = 2.85s
        setTimeout(function() {
          revLetters.forEach(function(l) { l.classList.add('glowing'); });
        }, 2900);
      })();

      function startRealCountdown() {
        var targetDate = new Date('2026-12-31T23:59:59').getTime();
        function update() {
          var now = new Date().getTime();
          var distance = targetDate - now;
          if (distance < 0) {
            var clock = document.getElementById('countdown-clock');
            if (clock) clock.innerHTML = "LOCKDOWN REACHED";
            return;
          }
          var days = Math.floor(distance / (1000 * 60 * 60 * 24));
          var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          var seconds = Math.floor((distance % (1000 * 60)) / 1000);
          var d = days.toString().padStart(2, '0');
          var h = hours.toString().padStart(2, '0');
          var m = minutes.toString().padStart(2, '0');
          var s = seconds.toString().padStart(2, '0');
          var dEl = document.getElementById('days');
          var hEl = document.getElementById('hours');
          var mEl = document.getElementById('minutes');
          var sEl = document.getElementById('seconds');
          if (dEl) dEl.textContent = d;
          if (hEl) hEl.textContent = h;
          if (mEl) mEl.textContent = m;
          if (sEl) sEl.textContent = s;
        }
        update();
        setInterval(update, 1000);
      }

      startRealCountdown();

      const observerOptions = { threshold: 0.2 };
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, observerOptions);

      document.querySelectorAll('.fade-in-element').forEach(el => observer.observe(el));

      // Show Director's Panel only in dev mode (localhost)
      if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
        var panel = document.getElementById('layout-editor');
        if (panel) panel.style.display = 'block';
      }

      // === Director's Mode — Container-based editor with persistent lock ===
      var currentLayer = null;
      var currentElement = null;

      function loadLockedPositions() {
        try {
          var saved = JSON.parse(localStorage.getItem('wwfp-locked-positions') || '{}');
          Object.keys(saved).forEach(function(id) {
            var el = document.getElementById(id);
            if (el) {
              el.style.top = saved[id].top;
              el.style.left = saved[id].left;
              if (saved[id].maxWidth) el.style.maxWidth = saved[id].maxWidth;
              if (saved[id].opacity !== undefined && saved[id].opacity !== '') el.style.opacity = saved[id].opacity;
              el.classList.add('elem-locked');
            }
          });
        } catch(e) { console.error('Load locked positions failed:', e); }
      }

      function getLockedData() {
        try { return JSON.parse(localStorage.getItem('wwfp-locked-positions') || '{}'); }
        catch(e) { return {}; }
      }

      function isLocked(id) {
        return id in getLockedData();
      }

      function saveLock(id, target) {
        var saved = getLockedData();
        saved[id] = {
          top: target.style.top || '',
          left: target.style.left || '',
          maxWidth: target.style.maxWidth || '',
          opacity: target.style.opacity || ''
        };
        localStorage.setItem('wwfp-locked-positions', JSON.stringify(saved));
      }

      function removeLock(id) {
        var saved = getLockedData();
        delete saved[id];
        localStorage.setItem('wwfp-locked-positions', JSON.stringify(saved));
      }

      // Apply locked positions immediately on page load
      loadLockedPositions();

      function populateElements() {
        var layerSelect = document.getElementById('layer-select');
        var elementSelect = document.getElementById('element-select');
        currentLayer = layerSelect.value;
        elementSelect.innerHTML = '<option value="">— select —</option>';
        if (!currentLayer) return;
        var layer = document.getElementById(currentLayer);
        if (!layer) return;
        layer.querySelectorAll('.banner-content').forEach(function(el) {
          var opt = document.createElement('option');
          opt.value = el.id;
          opt.textContent = el.id + (isLocked(el.id) ? ' LOCKED' : '');
          elementSelect.appendChild(opt);
        });
      }

      function updateLockButton() {
        var btn = document.getElementById('lock-container-btn');
        if (!btn || !currentElement) return;
        if (isLocked(currentElement)) {
          btn.innerText = 'Unlock Container';
          btn.style.background = '#c44';
          btn.style.color = 'white';
        } else {
          btn.innerText = 'Lock Container';
          btn.style.background = '';
          btn.style.color = '';
        }
      }

      function updateSliders(target) {
        document.querySelectorAll('#layout-editor input[type="range"]').forEach(function(slider) {
          var prop = slider.getAttribute('data-prop');
          if (prop === 'max-width') {
            var mw = parseInt(target.style.maxWidth) || 30;
            slider.value = mw;
            var vd = slider.nextElementSibling;
            if (vd) vd.innerText = mw + '%';
          } else if (prop === 'opacity') {
            var op = Math.round((parseFloat(target.style.opacity) || 1) * 100);
            slider.value = op;
            var vd2 = slider.nextElementSibling;
            if (vd2) vd2.innerText = op + '%';
          } else {
            var val = parseInt(target.style[prop]) || 0;
            slider.value = val;
            var vd3 = slider.nextElementSibling;
            if (vd3) vd3.innerText = val + '%';
          }
        });
      }

      document.getElementById('layer-select').addEventListener('change', populateElements);

      document.getElementById('element-select').addEventListener('change', function() {
        currentElement = this.value;
        var target = document.getElementById(currentElement);
        var display = document.getElementById('active-target');
        if (!target) {
          if (display) display.innerText = 'Select an element';
          updateLockButton();
          return;
        }
        if (display) display.innerText = currentElement + (isLocked(currentElement) ? ' LOCKED' : '');
        updateSliders(target);
        updateLockButton();
      });

      document.querySelectorAll('#layout-editor input[type="range"]').forEach(function(slider) {
        slider.addEventListener('input', function() {
          if (!currentElement) return;
          if (isLocked(currentElement)) return;
          var prop = this.getAttribute('data-prop');
          var val = this.value;
          var target = document.getElementById(currentElement);
          if (!target) return;
          if (prop === 'max-width') target.style.maxWidth = val + '%';
          else if (prop === 'opacity') target.style.opacity = val / 100;
          else target.style[prop] = val + '%';
          var vd = this.nextElementSibling;
          if (vd && vd.classList.contains('val')) vd.innerText = val + '%';
        });
      });

      document.getElementById('lock-container-btn').addEventListener('click', function() {
        if (!currentElement) return;
        var target = document.getElementById(currentElement);
        if (!target) return;
        if (isLocked(currentElement)) {
          removeLock(currentElement);
          target.classList.remove('elem-locked');
        } else {
          saveLock(currentElement, target);
          target.classList.add('elem-locked');
        }
        var display = document.getElementById('active-target');
        if (display) display.innerText = currentElement + (isLocked(currentElement) ? ' LOCKED' : '');
        updateLockButton();
        populateElements();
      });

      document.getElementById('export-btn').addEventListener('click', function() {
        var layers = ['space-1', 'space-2', 'space-3', 'space-4'];
        var saved = getLockedData();
        var output = '=== EXPORTED POSITIONS ===\n';
        layers.forEach(function(lid) {
          var layer = document.getElementById(lid);
          if (!layer) return;
          output += '\n[' + lid + ']\n';
          layer.querySelectorAll('.banner-content').forEach(function(el) {
            var locked = isLocked(el.id) ? 'LOCKED' : 'unlocked';
            var pos = saved[el.id] || { top: el.style.top||'', left: el.style.left||'', maxWidth: el.style.maxWidth||'', opacity: el.style.opacity||'' };
            output += '  ' + el.id + ': top=' + pos.top + ' left=' + pos.left + ' max-width=' + pos.maxWidth + ' opacity=' + pos.opacity + ' [' + locked + ']\n';
          });
        });
        console.log(output);
        var display = document.getElementById('active-target');
        if (display) display.innerText = 'Positions in console (F12)';
      });

      document.addEventListener('click', function(e) {
        var target = e.target.closest('.banner-content');
        if (!target) return;
        var layer = target.closest('.banner-space');
        if (!layer) return;
        var layerId = layer.id;
        var elementId = target.id;
        document.getElementById('layer-select').value = layerId;
        populateElements();
        document.getElementById('element-select').value = elementId;
        currentLayer = layerId;
        currentElement = elementId;
        var display = document.getElementById('active-target');
        if (display) display.innerText = elementId + (isLocked(elementId) ? ' LOCKED' : '');
        updateSliders(target);
        updateLockButton();
      });

      // Re-apply locked positions after Astro hot-reload
      setTimeout(loadLockedPositions, 500);
      populateElements();
    })();

    // Initialize Calibration Grid
    (function() {
      const grid = document.getElementById('calibration-grid');
      const toggle = document.getElementById('toggle-grid');
      const valDisplay = document.getElementById('grid-status');

      if (grid && toggle) {
        toggle.addEventListener('change', function() {
          grid.style.display = this.checked ? 'grid' : 'none';
          if (valDisplay) valDisplay.innerText = this.checked ? 'ON' : 'OFF';
        });

        // Create Grid Lines
        for (let i = 1; i < 10; i++) {
          const vLine = document.createElement('div');
          vLine.className = 'grid-line-v';
          vLine.style.left = (i * 10) + '%';
          grid.appendChild(vLine);

          const hLine = document.createElement('div');
          hLine.className = 'grid-line-h';
          hLine.style.top = (i * 10) + '%';
          grid.appendChild(hLine);

          const vLabel = document.createElement('div');
          vLabel.className = 'grid-label';
          vLabel.innerText = (i * 10) + '%';
          vLabel.style.left = (i * 10) + '%';
          vLabel.style.top = '5px';
          grid.appendChild(vLabel);

          const hLabel = document.createElement('div');
          hLabel.className = 'grid-label';
          hLabel.innerText = (i * 10) + '%';
          hLabel.style.top = (i * 10) + '%';
          hLabel.style.left = '5px';
          grid.appendChild(hLabel);
        }
      }
    })();
  </script>
</Base>
