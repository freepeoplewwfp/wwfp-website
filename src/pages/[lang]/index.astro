---
import Base from '../../layouts/Base.astro';
import { languages } from '../../i18n/config.js';
import { getTranslations } from '../../i18n/utils.js';
import { shops as shopData } from '../../data/shops.js';

export async function getStaticPaths() {
  return Object.keys(languages).map(code => ({
    params: { lang: code },
    props: { lang: code },
  }));
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<style>
/* All scoped styles remain here */
* {
  box-sizing: border-box;
}

#calibration-grid {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 10000;
  display: none;
  width: 100vw;
  height: 100vh;
  border: 2px solid rgba(124, 252, 0, 0.5);
}

.grid-line-v {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 1px;
  background: rgba(124, 252, 0, 0.3);
}

.grid-line-h {
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background: rgba(124, 252, 0, 0.3);
}

.grid-label {
  position: absolute;
  font-size: 10px;
  color: rgba(124, 252, 0, 0.6);
  font-family: monospace;
}

#layout-editor {
  position: fixed;
  top: 20px;
  right: 20px;
  width: 260px;
  background: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 15px;
  border-radius: 12px;
  z-index: 9999;
  font-family: sans-serif;
  font-size: 13px;
  border: 1px solid #7cfc00;
  backdrop-filter: blur(10px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  display: none;
}

#editor-header {
  font-weight: bold;
  margin-bottom: 15px;
  padding-bottom: 8px;
  border-bottom: 1px solid #444;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #7cfc00;
}

.editor-target {
  background: rgba(124, 252, 0, 0.2);
  padding: 8px;
  border-radius: 6px;
  margin-bottom: 15px;
  text-align: center;
  font-weight: bold;
  border: 1px dashed #7cfc00;
}

.slider-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}

.slider-row label {
  width: 40px;
  font-size: 11px;
  text-transform: uppercase;
  opacity: 0.8;
}

.slider-row input {
  flex: 1;
  cursor: pointer;
}

.slider-row .val {
  width: 40px;
  text-align: right;
  font-family: monospace;
  color: #7cfc00;
}

.lock-btn {
  width: 100%;
  padding: 10px;
  background: #7cfc00;
  color: black;
  border: none;
  border-radius: 6px;
  font-weight: bold;
  cursor: pointer;
  transition: background 0.2s;
  text-transform: uppercase;
  font-size: 12px;
}

.lock-btn:hover {
  background: #adff2f;
}

.lock-btn.locked {
  background: #444;
  color: #888;
  cursor: not-allowed;
}

.banner-space {
  position: relative;
  width: 100%;
  height: auto;
  background-color: #051a0f;
  overflow: hidden;
  display: block;
}

/* Per-banner gradient overlays — adapt text readability to image darkness */
#space-1::before { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(5, 15, 10, 0.3) 0%, rgba(5, 15, 10, 0.1) 40%, rgba(5, 15, 10, 0.4) 80%, rgba(5, 15, 10, 0.6) 100%); z-index: 1; pointer-events: none; }
#space-2::before { content: ""; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(10, 15, 25, 0.4) 0%, rgba(10, 15, 25, 0.15) 50%, rgba(10, 15, 25, 0.5) 100%); z-index: 1; pointer-events: none; }
#space-3::before { content: ""; position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(5, 15, 10, 0.1) 0%, rgba(5, 15, 10, 0.4) 70%, rgba(5, 15, 10, 0.6) 100%); z-index: 1; pointer-events: none; }
#space-4::before { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(3, 5, 8, 0.5) 0%, rgba(3, 5, 8, 0.2) 50%, rgba(3, 5, 8, 0.6) 100%); z-index: 1; pointer-events: none; }

.banner-image {
  position: relative;
  display: block;
  width: 100%;
  height: auto;
  opacity: 0.55;
  pointer-events: none;
  z-index: 0;
}

.banner-content {
  position: absolute;
  top: 10%;
  left: 50%;
  z-index: 3;
  text-align: center;
  width: auto;
}

/* Position classes removed — all positioning is now inline styles per element */
.content-left, .content-right, .content-left-text, .content-right-text {
  z-index: 3;
  margin: 0;
  padding: 0;
}

/* Director's Panel — Layer Selector */
.layer-selector, .element-selector {
  margin-bottom: 12px;
}
.layer-label {
  display: block;
  font-size: 11px;
  text-transform: uppercase;
  opacity: 0.8;
  margin-bottom: 4px;
}
#layer-select, #element-select {
  width: 100%;
  padding: 6px 8px;
  background: rgba(0,0,0,0.5);
  color: #7cfc00;
  border: 1px solid #444;
  border-radius: 4px;
  font-size: 12px;
  cursor: pointer;
}
#layer-select option, #element-select option {
  background: #111;
  color: #ccc;
}
/* Per-element lock — just a visual marker, no screen-wide effect */
.elem-locked {
  outline: 1px dashed rgba(255, 100, 100, 0.5);
  outline-offset: 4px;
}
.elem-locked::after {
  content: ' 🔒';
  font-size: 0.7em;
  opacity: 0.7;
}

.typewriter-text {
  font-family: var(--font-head);
  font-size: 2rem;
  font-weight: 800;
  color: rgba(60, 95, 85, 0.75);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  margin: 0;
  -webkit-text-stroke: 0.4px rgba(124, 252, 0, 0.35);
  text-shadow: 0 0 2px rgba(0, 0, 0, 0.6);
}

.banner-title {
  font-family: var(--font-head);
  font-size: 2.1rem;
  font-weight: 800;
  margin-bottom: var(--space-md);
  line-height: 1.3;
  padding: 2px 6px;
}

/* Per-banner text colors — each adapted to its image tone */
#space-1 .banner-text { background: linear-gradient(180deg, rgba(60, 100, 90, 0.95) 0%, rgba(140, 180, 160, 0.9) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; -webkit-text-stroke: 0.4px rgba(124, 252, 0, 0.4); filter: drop-shadow(0 0 8px rgba(124, 252, 0, 0.12)) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.7)); }
#space-1 .banner-title { background: linear-gradient(180deg, rgba(70, 110, 100, 0.95) 0%, rgba(150, 190, 170, 0.9) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; -webkit-text-stroke: 0.5px rgba(124, 252, 0, 0.45); filter: drop-shadow(0 0 10px rgba(124, 252, 0, 0.15)) drop-shadow(0 1px 3px rgba(0, 0, 0, 0.7)); }

#space-2 .banner-text { color: rgba(70, 75, 95, 0.85); -webkit-text-stroke: 0.4px rgba(124, 252, 0, 0.3); text-shadow: 0 0 1px rgba(5, 5, 15, 0.5); }
#space-2 .banner-title { color: rgba(80, 85, 105, 0.85); -webkit-text-stroke: 0.4px rgba(124, 252, 0, 0.3); text-shadow: 0 0 1px rgba(5, 5, 15, 0.5); }

#space-3 .banner-text { color: rgba(90, 80, 60, 0.85); -webkit-text-stroke: 0.4px rgba(180, 200, 0, 0.3); text-shadow: 0 0 1px rgba(10, 5, 0, 0.5); }
#space-3 .banner-title { color: rgba(100, 90, 70, 0.85); -webkit-text-stroke: 0.4px rgba(180, 200, 0, 0.3); text-shadow: 0 0 1px rgba(10, 5, 0, 0.5); }

#space-4 .banner-text { color: rgba(65, 75, 90, 0.85); -webkit-text-stroke: 0.4px rgba(100, 200, 50, 0.3); text-shadow: 0 0 1px rgba(0, 0, 5, 0.5); }
#space-4 .banner-title { color: rgba(75, 85, 100, 0.85); -webkit-text-stroke: 0.4px rgba(100, 200, 50, 0.3); text-shadow: 0 0 1px rgba(0, 0, 5, 0.5); }

.banner-text {
  font-size: 0.84rem;
  opacity: 1;
  line-height: 1.7;
  padding: 4px 8px;
}

@keyframes countdownPulse { 0%, 100% { text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9), 0 0 8px rgba(5, 15, 10, 0.4); } 50% { text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9), 0 0 15px rgba(124, 252, 0, 0.2), 0 0 25px rgba(5, 15, 10, 0.5); } }

.fade-in-element {
  opacity: 1;
  transition: opacity 2s ease-in-out;
}

.fade-in-element.visible {
  opacity: 1;
}

.cursor {
  display: inline-block;
  width: 3px;
  background-color: var(--color-leaf);
  margin-left: 5px;
  animation: blink 0.7s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.video-hero {
  position: relative;
  height: 100vh;
  width: 100%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 90%;
  z-index: 0;
}

.video-hero-poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background-size: 115%;
  background-position: center 90%;
  z-index: 0;
  display: none;
}

.video-hero-bg {
  z-index: 1;
}

.video-hero-bg:not([src]) {
  z-index: 0;
}

.video-hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.3) 0%,
    rgba(0, 0, 0, 0.2) 50%,
    rgba(26, 58, 36, 0.6) 100%
  );
}

.video-hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 0 var(--space-md);
  max-width: 800px;
}

.video-play-btn {
  background: rgba(0, 0, 0, 0.6);
  border: 2px solid rgba(255, 255, 255, 0.4);
  border-radius: 50px;
  color: var(--color-cream);
  font-size: 1.2rem;
  font-weight: 600;
  padding: 16px 32px;
  cursor: pointer;
  transition: background 0.3s, transform 0.3s;
  backdrop-filter: blur(8px);
}

.video-play-btn:hover {
  background: rgba(0, 0, 0, 0.8);
  transform: scale(1.05);
}

.video-replay-btn {
  background: rgba(0, 0, 0, 0.5);
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 50px;
  color: var(--color-cream);
  font-size: 1rem;
  font-weight: 500;
  padding: 12px 28px;
  cursor: pointer;
  transition: background 0.3s, transform 0.3s;
  backdrop-filter: blur(8px);
}

.video-replay-btn:hover {
  background: rgba(0, 0, 0, 0.7);
  transform: scale(1.05);
}

html {
  scroll-behavior: smooth;
}

@media (max-width: 768px) {
  body { overflow-x: hidden; }
  .video-hero { height: auto; aspect-ratio: 16/9; min-height: 0; padding-top: 0; }
  .video-hero-bg { object-fit: contain; object-position: center center; height: 100%; }
  .video-hero-poster { background-size: contain; background-position: center center; background-repeat: no-repeat; background-color: #000; }
  .video-hero-overlay { background: linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.1) 50%, rgba(26,58,36,0.4) 100%); }
  .video-play-btn { font-size: 1rem; padding: 12px 24px; }
  .video-replay-btn { font-size: 0.9rem; padding: 10px 22px; }
}
</style>

<Base lang={lang} t={t}>
  <!-- Fullscreen Video Hero -->
  <section id="top" class="video-hero">
    <video class="video-hero-bg" id="heroVideo" playsinline preload="metadata" crossorigin="anonymous" poster="/videos/about-us-frame.jpg"></video>
    <div class="video-hero-poster" id="heroPoster" style="background-image: url('/videos/about-us-frame.jpg'); display: block;"></div>
    <div class="video-hero-overlay"></div>
    <div class="video-hero-content">
      <button class="video-play-btn" id="playBtn">▶ Play with Sound</button>
      <button class="video-replay-btn" id="replayBtn" style="display:none">▶ Replay</button>
    </div>
  </section>

  <section class="banner-space" id="space-1">
    <img src="/Website Banners/Firewall.jpg" alt="Banner 1" class="banner-image" />

    <div class="banner-content" id="pos-identity" style="position: absolute; top: 5%; left: 50%; transform: translate(-50%, 0)">
      <h1 class="typewriter-text" id="typewriter">WWFP · Identity</h1>
    </div>

    <div class="banner-content content-left fade-in-element" id="pos-left-title" style="position: absolute; top: 17%; left: 12%; max-width: 320px">
      <h2 class="banner-title">Wer wir sind</h2>
    </div>

    <div class="banner-content content-right fade-in-element" id="pos-right-title" style="position: absolute; top: 17%; left: 70%; max-width: 320px">
      <h2 class="banner-title">Wie wir uns finanzieren</h2>
    </div>

    <div class="banner-content fade-in-element" id="pos-warning" style="position: absolute; top: 26%; left: 50%; transform: translate(-50%, 0)">
      <p class="banner-text" style="font-weight: bold; font-size: 0.9rem; color: rgba(70, 100, 90, 0.8); -webkit-text-stroke: 0.4px rgba(124, 252, 0, 0.35); text-shadow: 0 0 2px rgba(0, 0, 0, 0.6); text-align: center; line-height: 1.4; width: 280px; margin: 0 auto; letter-spacing: 0.02em;">
        Dein Handy wird bald<br>nicht mehr dir gehören.
      </p>
    </div>

    <div class="banner-content content-left" id="pos-left-text" style="position: absolute; top: 25%; left: 12%; max-width: 15%">
      <p class="banner-text">
        Die Free People Organization ist ein gemeinnütziger Verein, der sich selbst trägt.
        Ein internationales Netzwerk von Menschen, die nicht gegen Probleme protestieren,
        sondern anfangen, so zu leben, wie es sein sollte. Wir bauen Lebensräume,
        schützen die Umwelt und schaffen Orte, an denen Wissen, Kunst und gemeinschaftliches
        Arbeiten fließen. Wo Menschen gedeihen, statt zu überleben.
      </p>
    </div>


    <div class="banner-content content-right-text" id="pos-right-text" style="position: absolute; top: 29%; left: 73%; max-width: 14%">
      <p class="banner-text">
        Durch eigene wirtschaftliche Geschäftsbetriebe — nicht durch Spenden allein. Jeder Euro fließt zu 100% in unsere Zwecke.<br><br>
        Einnahmen → Hostel-Infrastruktur → Räume für Menschen die mithelfen → produzieren und verkaufen → neue Einnahmen → weitere Lebensräume.
      </p>
    </div>

    <div class="banner-content" id="pos-revolution" style="position: absolute; top: 75%; left: 50%; transform: translate(-50%, 0); z-index: 10">
      <style>
        .revolution-text { font-family: 'Impact', 'Arial Black', 'Helvetica Neue', sans-serif; font-size: 3.5rem; font-weight: 900; letter-spacing: 0.02em; margin: 0; text-align: center; }
        .rev-letter { display: inline-block; opacity: 0; animation: revRise 1.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; color: rgba(70, 105, 90, 0.7); -webkit-text-stroke: 0.5px rgba(124, 252, 0, 0.4); text-shadow: 0 0 2px rgba(0, 0, 0, 0.6); }
        .rev-e { display: inline-block; opacity: 0; animation: revRise 1.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards, revWobble 2s ease-in-out 1.5s infinite; color: rgba(70, 105, 90, 0.7); -webkit-text-stroke: 0.5px rgba(124, 252, 0, 0.4); text-shadow: 0 0 2px rgba(0, 0, 0, 0.6); }
        @keyframes revRise {
          0% { opacity: 0; transform: translateY(60px) rotate(-15deg) scale(0.3); filter: blur(15px) brightness(0.2); }
          40% { opacity: 0.6; transform: translateY(-8px) rotate(3deg) scale(1.15); filter: blur(2px) brightness(0.8); }
          70% { opacity: 0.9; transform: translateY(2px) rotate(-1deg) scale(0.95); filter: blur(0px) brightness(1.2); }
          100% { opacity: 1; transform: translateY(0) rotate(0) scale(1); filter: blur(0px) brightness(1); text-shadow: 0 0 15px rgba(124, 252, 0, 0.3), 0 0 30px rgba(0, 80, 0, 0.2); }
        }
        @keyframes revWobble {
          0%, 100% { transform: rotate(0deg) translateY(0); }
          20% { transform: rotate(-4deg) translateY(-2px); }
          40% { transform: rotate(3deg) translateY(1px); }
          60% { transform: rotate(-2deg) translateY(-1px); }
          80% { transform: rotate(1deg) translateY(0); }
        }
        .rev-letter.glowing { animation: revPulse 2.5s ease-in-out infinite; opacity: 1 !important; }
        .rev-e.glowing { animation: revPulse 2.5s ease-in-out infinite, revWobble 2s ease-in-out infinite; opacity: 1 !important; }
        @keyframes revPulse {
          0%, 100% { color: rgba(70, 105, 90, 0.7); -webkit-text-stroke: 0.5px rgba(124, 252, 0, 0.4); text-shadow: 0 0 2px rgba(0, 0, 0, 0.6); }
          50% { color: rgba(85, 125, 105, 0.8); -webkit-text-stroke: 0.5px rgba(124, 252, 0, 0.4); text-shadow: 0 0 4px rgba(80, 120, 100, 0.3); }
        }
      </style>
      <h1 class="revolution-text">
        <span class="rev-letter" style="animation-delay: 0s">R</span><span class="rev-letter" style="animation-delay: 0.15s">(</span><span class="rev-e" style="animation-delay: 0.3s">e</span><span class="rev-letter" style="animation-delay: 0.45s">)</span><span class="rev-letter" style="animation-delay: 0.6s">v</span><span class="rev-letter" style="animation-delay: 0.75s">o</span><span class="rev-letter" style="animation-delay: 0.9s">l</span><span class="rev-letter" style="animation-delay: 1.05s">u</span><span class="rev-letter" style="animation-delay: 1.2s">t</span><span class="rev-letter" style="animation-delay: 1.35s">i</span><span class="rev-letter" style="animation-delay: 1.5s">o</span><span class="rev-letter" style="animation-delay: 1.65s">n</span>
      </h1>
    </div>

    <div class="banner-content fade-in-element" id="pos-countdown" style="position: absolute; top: 39%; left: 50%; transform: translate(-50%, 0)">
      <div id="countdown-clock" style="display: flex; gap: 20px; justify-content: center; align-items: center; font-family: monospace; font-weight: bold; color: rgba(180, 255, 180, 0.9); font-size: 1.8rem; -webkit-text-stroke: 0.5px rgba(124, 252, 0, 0.5); text-shadow: 0 0 4px rgba(0, 0, 0, 0.8), 0 0 12px rgba(124, 252, 0, 0.25); animation: countdownPulse 3s ease-in-out infinite;">
        <div style="text-align: center;"><span id="days">--</span><div style="font-size: 0.7rem; text-transform: uppercase; opacity: 0.8;">Days</div></div>
        <div style="font-size: 1.5rem;">:</div>
        <div style="text-align: center;"><span id="hours">--</span><div style="font-size: 0.7rem; text-transform: uppercase; opacity: 0.8;">Hours</div></div>
        <div style="font-size: 1.5rem;">:</div>
        <div style="text-align: center;"><span id="minutes">--</span><div style="font-size: 0.7rem; text-transform: uppercase; opacity: 0.8;">Mins</div></div>
        <div style="font-size: 1.5rem;">:</div>
        <div style="text-align: center;"><span id="seconds">--</span><div style="font-size: 0.7rem; text-transform: uppercase; opacity: 0.8;">Secs</div></div>
      </div>
      <p style="text-align: center; margin-top: 10px; color: rgba(150, 200, 170, 0.8); font-size: 0.9rem; font-weight: normal; letter-spacing: 0.15em; text-transform: uppercase; -webkit-text-stroke: 0.4px rgba(124, 252, 0, 0.4); text-shadow: 0 0 3px rgba(0, 0, 0, 0.8);">until lockdown</p>
    </div>

    <!-- Countdown script — direct, always runs -->
    <script>
      (function() {
        var targetDate = new Date('2026-12-31T23:59:59').getTime();
        function update() {
          var now = new Date().getTime();
          var distance = targetDate - now;
          if (distance < 0) {
            var clock = document.getElementById('countdown-clock');
            if (clock) clock.innerHTML = 'LOCKDOWN REACHED';
            return;
          }
          var days = Math.floor(distance / (1000 * 60 * 60 * 24));
          var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          var seconds = Math.floor((distance % (1000 * 60)) / 1000);
          var d = days.toString().padStart(2, '0');
          var h = hours.toString().padStart(2, '0');
          var m = minutes.toString().padStart(2, '0');
          var s = seconds.toString().padStart(2, '0');
          var dEl = document.getElementById('days');
          var hEl = document.getElementById('hours');
          var mEl = document.getElementById('minutes');
          var sEl = document.getElementById('seconds');
          if (dEl) dEl.textContent = d;
          if (hEl) hEl.textContent = h;
          if (mEl) mEl.textContent = m;
          if (sEl) sEl.textContent = s;
        }
        update();
        setInterval(update, 1000);
      })();
    </script>

    <!-- Google Lockdown Info Text -->
    <div class="banner-content fade-in-element" id="pos-google-info" style="position: absolute; top: 55%; left: 50%; transform: translate(-50%, 0); z-index: 3; max-width: 500px; text-align: center;">
      <p class="banner-text" style="font-size: 0.8rem; line-height: 1.6; text-align: center; color: rgba(60, 90, 80, 0.75); -webkit-text-stroke: 0.4px rgba(124, 252, 0, 0.35); text-shadow: 0 0 2px rgba(0, 0, 0, 0.6);">
        Starting in 2027, a silent update, nonconsensually pushed by Google, will block every Android app whose developer hasn't registered with Google, signed their contract, paid up, and handed over government ID. Every app and every device, worldwide, with no opt-out.
      </p>
    </div>

    <div class="banner-content fade-in-element" id="pos-spread" style="position: absolute; top: 55%; left: 50%; transform: translate(-50%, 0); z-index: 10">
      <a href="https://keepandroidopen.org" target="_blank" rel="noopener noreferrer" style="color: rgba(65, 95, 85, 0.75); font-size: 0.9rem; font-weight: normal; text-decoration: none; -webkit-text-stroke: 0.4px rgba(124, 252, 0, 0.35); text-shadow: 0 0 2px rgba(0, 0, 0, 0.6); border-bottom: 1px solid rgba(65, 95, 85, 0.3); letter-spacing: 0.05em; transition: all 0.3s; padding-bottom: 2px; transition: color 0.3s;">↓ Spread the word</a>
    </div>

