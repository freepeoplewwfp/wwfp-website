---
import Base from '../../layouts/Base.astro';
import { languages } from '../../i18n/config.js';
import { getTranslations } from '../../i18n/utils.js';

export async function getStaticPaths() {
  return Object.keys(languages).map(code => ({
    params: { lang: code },
    props: { lang: code },
  }));
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<Base lang={lang} t={t}>
  <section class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="page-hero-overlay"></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="coc-sections">
        {t.codeOfConduct.sections.map((section, i) => (
          <details class="coc-section" open={i < 3}>
            <summary class="coc-summary">
              <span class="coc-number">{i + 1}</span>
              <span class="coc-title">{section.title.replace(/^\d+\.\s*/, '')}</span>
              <span class="coc-chevron">▾</span>
            </summary>
            <div class="coc-content">
              <p>{section.text}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
.page-hero { position: relative; padding: var(--space-xl) var(--space-md); overflow: hidden; background: #0d1f15; display: flex; align-items: center; justify-content: center; text-align: center; }
.page-hero-bg { position: absolute; inset: 0; background-image: url("/images/Firewall.jpg"); background-size: cover; background-position: center; opacity: 0.5; z-index: 0; }
.page-hero-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.3); z-index: 1; }
.page-hero-content { display: none; }
.page-hero-text { color: #90ee90; font-size: 1.15rem; max-width: 700px; margin: 0 auto; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }

.coc-sections {
  max-width: 800px;
  margin: 0 auto;
}

.coc-section {
  border-bottom: 1px solid var(--color-border);
}

.coc-summary {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
  cursor: pointer;
  list-style: none;
  font-size: 1.1rem;
  color: var(--color-forest-deep);
}

.coc-summary::-webkit-details-marker { display: none; }

.coc-number {
  background: var(--color-forest);
  color: var(--color-cream);
  border-radius: 50%;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  font-weight: bold;
}

.coc-title {
  font-family: var(--font-head);
  flex: 1;
}

.coc-chevron {
  transition: transform var(--transition);
  color: var(--color-text-muted);
}

details[open] .coc-chevron {
  transform: rotate(180deg);
}

.coc-content {
  padding: 0 0 var(--space-sm) 48px;
  color: var(--color-text-light);
}
</style>