---
import Base from '../../layouts/Base.astro';
import { languages } from '../../i18n/config.js';
import { getTranslations } from '../../i18n/utils.js';

export async function getStaticPaths() {
  return Object.keys(languages).map(code => ({
    params: { lang: code },
    props: { lang: code },
  }));
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<Base lang={lang} t={t}>
  <section class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="container page-hero-content">
      <h1>{t.contact.title}</h1>
      <p class="page-hero-text">{t.contact.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <!-- Info -->
        <div class="contact-info">
          <div class="contact-block">
            <h3>📍 Address</h3>
            <p>{t.contact.address}</p>
          </div>

          <div class="contact-block">
            <h3>✉️ {t.contact.email}</h3>
            <p><a href="mailto:info@wwfp.global">info@wwfp.global</a></p>
          </div>

          <div class="contact-block">
            <h3>📞 {t.contact.phone}</h3>
            <p>{t.contact.phoneChris}: <a href="tel:+436505972706">+43 650 597 2706</a></p>
            <p>{t.contact.phoneDieter}: <a href="tel:+4366473430620">+43 664 734 30 620</a></p>
          </div>

          <div class="contact-block">
            <h3>🌐 {t.contact.social}</h3>
            <div class="social-links">
              <a href="#" class="social-link">Instagram</a>
              <a href="#" class="social-link">Facebook</a>
              <a href="#" class="social-link">Twitter</a>
              <a href="#" class="social-link">YouTube</a>
            </div>
          </div>
        </div>

        <!-- Form -->
        <div class="contact-form card">
          <h3 class="mb-md">Write us</h3>
          <form>
            <div class="form-group">
              <label for="name">{t.contact.formName}</label>
              <input type="text" id="name" name="name" required />
            </div>
            <div class="form-group">
              <label for="email">{t.contact.formEmail}</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="form-group">
              <label for="message">{t.contact.formMessage}</label>
              <textarea id="message" name="message" rows="5" required></textarea>
            </div>
            <button type="submit" class="btn btn--primary">{t.contact.formSubmit}</button>
            <p class="form-note">{t.contact.formNote}</p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
.page-hero { position: relative; padding: 0; overflow: hidden; background: transparent; justify-content: center; display: flex; align-items: flex-end; padding-bottom: 2rem; min-height: 60vh; }
.page-hero-bg { position: absolute; inset: 0; background-image: url('/images/contact.jpeg'); background-size: cover; background-position: center 0%; }
.page-hero-content { position: relative; z-index: 1; text-align: center; width: 33%; background: transparent; padding-left: var(--space-md); margin-left: 0%; }
.page-hero h1 { color: #2d8a3d; margin-bottom: 0.2rem; text-shadow: 0.3px 0 #fff, -0.3px 0 #fff, 0 0.3px #fff, 0 -0.3px #fff; }
.page-hero-text { color: #2d8a3d; font-size: 1.15rem; max-width: 100%; margin: 0; text-shadow: 0.3px 0 #fff, -0.3px 0 #fff, 0 0.3px #fff, 0 -0.3px #fff; }

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: var(--space-lg);
  max-width: 900px;
  margin: 0 auto;
}

.contact-block {
  margin-bottom: var(--space-md);
}

.contact-block h3 {
  margin-bottom: 0.3rem;
}

.social-links {
  display: flex;
  gap: var(--space-sm);
  flex-wrap: wrap;
}

.social-link {
  padding: 0.4rem 1rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  font-size: 0.9rem;
}

.social-link:hover {
  border-color: var(--color-forest);
}

.form-group {
  margin-bottom: var(--space-sm);
}

.form-group label {
  display: block;
  margin-bottom: 0.3rem;
  font-size: 0.9rem;
  color: var(--color-text-light);
}

.form-group input,
.form-group textarea {
  width: 100%;
  padding: 0.6rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  font-family: var(--font-body);
  font-size: 1rem;
  background: var(--color-paper);
}

.form-group input:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--color-forest);
}

.form-note {
  font-size: 0.8rem;
  color: var(--color-text-muted);
  margin-top: var(--space-sm);
  font-style: italic;
}

@media (max-width: 768px) {
  .contact-grid { grid-template-columns: 1fr; }
}
</style>