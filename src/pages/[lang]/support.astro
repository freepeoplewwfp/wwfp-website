---
import Base from '../../layouts/Base.astro';
import { languages } from '../../i18n/config.js';
import { getTranslations } from '../../i18n/utils.js';

export async function getStaticPaths() {
  return Object.keys(languages).map(code => ({
    params: { lang: code },
    props: { lang: code },
  }));
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<Base lang={lang} t={t}>
  <section class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="page-hero-overlay"></div>
    <div class="container page-hero-content">
      <div class="page-hero-left">
        <span class="page-hero-support">Support</span>
        <span class="page-hero-ourwork">Our Work</span>
      </div>
      <div class="page-hero-right">
        <span class="page-hero-wwfp">WWFP</span>
        <p class="page-hero-resttext">is financed exclusively through private donations. We do not accept money from governments, corporations, or political parties. This is how we stay independent.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="support-lead">Unsere Sponsoren stellen sicher, dass WWFP weltweit eingesetzt werden kann. Wir ehren diese Unterstützung, indem wir Spenden sparsam und verantwortungsvoll einsetzen.</p>

      <div class="donation-grid">
        <!-- Bank Transfer -->
        <div class="card donation-card">
          <div class="card-icon">🏦</div>
          <h3>{t.support.bankTitle}</h3>
          <p>{t.support.bankText}</p>
          <div class="bank-details">
            <p><strong>{t.support.bankHolder}</strong></p>
            <p>{t.support.bankIBAN}</p>
            <p>{t.support.bankBIC}</p>
            <p>{t.support.bankAddress}</p>
          </div>
          <p class="bank-note">{t.support.bankNote}</p>
          <p class="bank-note" style="font-weight: 700; color: var(--color-primary);">⚠️ Wichtig! Verwendungszweck: Spende an WWFP</p>
        </div>

        <!-- PayPal -->
        <div class="card donation-card">
          <div class="card-icon">💳</div>
          <h3>{t.support.paypalTitle}</h3>
          <p>{t.support.paypalText}</p>
          <a href="#" class="btn btn--primary mt-md" onclick="return false;">
            {t.support.paypalButton}
          </a>
          <p class="paypal-note">PayPal link coming soon</p>
        </div>

        <!-- Bank Transfer 2 - Raiffeisenbank -->
        <div class="card donation-card">
          <div class="card-icon">🏦</div>
          <h3>Banküberweisung</h3>
          <p>Überweise deine Spende direkt auf unser Bankkonto. Jeder Betrag hilft, Lebensräume zu schaffen und unseren Heimatplaneten zu schützen.</p>
          <div class="bank-details">
            <p><strong>Account Holder: Dieter Scheikl</strong></p>
            <p>IBAN: AT13 3742 0000 0030 4295</p>
            <p>SWIFT/BIC: RVVGAT2B420</p>
            <p>Raiffeisenbank im Rheintal</p>
          </div>
          <p class="bank-note">Private account — NPO business account coming soon.</p>
          <p class="bank-note" style="font-weight: 700; color: var(--color-primary);">⚠️ Wichtig! Verwendungszweck: Spende an WWFP</p>
        </div>
      </div>

      <!-- Transparency -->
      <div class="transparency-box mt-lg">
        <h3>📊 {t.support.transparencyTitle}</h3>
        <p>Wir verwenden alle Spenden sparsam und verantwortungsvoll. Geld ist ein Mittel zum Zweck — wir bündeln unsere Energie und schaffen weltweit Lebensräume.</p>
      </div>

    </div>
  </section>
</Base>

<style>
.page-hero { position: relative; padding: var(--space-xl) 0; overflow: hidden; background: transparent; display: flex; align-items: center; }
.page-hero-bg { position: absolute; inset: 0; background-image: url('/images/wwfp-22.jpg'); background-size: cover; background-position: center 12.5%; }
.page-hero-overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.1) 30%, rgba(0,0,0,0.1) 70%, rgba(0,0,0,0.55) 100%); z-index: 1; }
.page-hero-content { position: relative; z-index: 2; width: 100%; background: transparent; display: flex; justify-content: space-between; align-items: center; }
.page-hero-left { text-align: left; max-width: 35%; display: flex; flex-direction: column; }
.page-hero-right { text-align: left; max-width: 38%; margin-left: auto; }
.page-hero-support { color: #aaffaa; font-size: 4.5rem; font-weight: 700; line-height: 1; text-shadow: 0 0 3px #000, 0 0 6px rgba(0,0,0,0.8), 0 2px 8px rgba(0,0,0,0.9); -webkit-text-stroke: 2px rgba(0,0,0,0.6); display: block; margin-bottom: 0.3rem; }
.page-hero-ourwork { color: #aaffaa; font-size: 2.25rem; font-weight: 600; line-height: 1.2; text-shadow: 0 2px 4px rgba(0,0,0,0.5); display: block; }
.page-hero-wwfp { color: #90ee90; font-size: 3.6rem; font-weight: 800; line-height: 1; text-shadow: 0 0 3px #000, 0 0 6px rgba(0,0,0,0.8), 0 2px 8px rgba(0,0,0,0.9); -webkit-text-stroke: 2px rgba(0,0,0,0.6); display: block; margin-bottom: 1.2rem; letter-spacing: 0.02em; }
.page-hero-resttext { color: #90ee90; font-size: 1.05rem; line-height: 1.5; text-shadow: 0 0 2px #000, 0 1px 4px rgba(0,0,0,0.7); -webkit-text-stroke: 0.5px rgba(0,0,0,0.4); margin: 0; padding-left: 0.8rem; max-width: 340px; }

.support-lead {
  font-size: 1.15rem;
  color: var(--color-text-light);
  max-width: 100%;
  margin: 0 auto var(--space-md);
  text-align: center;
}

.donation-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: var(--space-md);
  max-width: 1100px;
  margin: 0 auto;
}

.card-icon {
  font-size: 2.5rem;
  margin-bottom: var(--space-sm);
}

.bank-details {
  background: var(--color-bg-alt);
  border-radius: var(--radius);
  padding: var(--space-sm);
  margin-top: var(--space-sm);
  font-size: 0.9rem;
}

.bank-details p { margin: 0.2rem 0; }

.bank-note, .paypal-note {
  font-size: 0.85rem;
  color: var(--color-text-muted);
  margin-top: var(--space-sm);
  font-style: italic;
}

.transparency-box {
  background: var(--color-bg-alt);
  border-radius: var(--radius-lg);
  padding: var(--space-md);
  max-width: 100%;
  margin: 0 auto;
  text-align: center;
  font-size: 0.95rem;
}

@media (max-width: 768px) {
  .donation-grid { grid-template-columns: 1fr; }
  .page-hero { padding: var(--space-md) 0; }
  .page-hero-bg { background-size: cover; background-position: center; }
  .page-hero-content { flex-direction: column; gap: var(--space-md); text-align: center; }
  .page-hero-left, .page-hero-right { text-align: center; max-width: 100%; margin-left: 0; }
  .page-hero-support { font-size: 2.8rem; }
  .page-hero-ourwork { font-size: 1.6rem; }
  .page-hero-wwfp { font-size: 2.2rem; }
  .page-hero-resttext { padding-left: 0; margin: 0 auto; font-size: 0.95rem; }
}
</style>