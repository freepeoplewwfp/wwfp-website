---
import { languages } from '../i18n/config.js';

const { lang, t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <div class="footer-logo">
          <span style="font-size: 1.4rem;">🌍</span>
          <strong>WWFP</strong>
        </div>
        <p class="footer-tagline">{t.footer.tagline}</p>
      </div>

      <div class="footer-col">
        <h4>{t.nav.getInvolved}</h4>
        <ul>
          <li><a href={`/wwfp-website/${lang}/get-involved`}>{t.getInvolved.passiveTitle.replace('Become a ', '')}</a></li>
          <li><a href={`/wwfp-website/${lang}/get-involved`}>{t.getInvolved.activeTitle.replace('Become an ', '')}</a></li>
          <li><a href={`/wwfp-website/${lang}/support`}>{t.nav.support}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>{t.nav.contact}</h4>
        <ul>
          <li>{t.contact.address}</li>
          <li><a href={`/wwfp-website/${lang}/contact`}>{t.contact.title}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>{t.nav.codeOfConduct}</h4>
        <ul>
          <li><a href={`/wwfp-website/${lang}/code-of-conduct`}>{t.codeOfConduct.title}</a></li>
          <li><a href={`/wwfp-website/${lang}/values`}>{t.nav.values}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {t.footer.rights}</p>
      <div class="footer-langs">
        {Object.values(languages).map(l => (
          <a href={`/wwfp-website/${l.code}`} class={l.code === lang ? 'footer-lang active' : 'footer-lang'}>
            {l.flag}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
.site-footer {
  background: var(--color-forest-deep);
  color: var(--color-sage);
  padding: var(--space-lg) 0 var(--space-md);
  margin-top: var(--space-lg);
}

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
}

.footer-logo {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 1.4rem;
  color: var(--color-cream);
  margin-bottom: 0.5rem;
}

.footer-tagline {
  font-style: italic;
  color: var(--color-sage);
  max-width: 300px;
}

.footer-col h4 {
  color: var(--color-cream);
  font-size: 1rem;
  margin-bottom: 0.5rem;
}

.footer-col ul {
  list-style: none;
}

.footer-col li {
  margin-bottom: 0.3rem;
  font-size: 0.9rem;
}

.footer-col a {
  color: var(--color-sage);
  text-decoration: none;
}

.footer-col a:hover {
  color: var(--color-cream);
}

.footer-bottom {
  border-top: 1px solid rgba(245, 239, 224, 0.15);
  padding-top: var(--space-sm);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.footer-bottom p {
  font-size: 0.85rem;
  margin: 0;
}

.footer-langs {
  display: flex;
  gap: 0.5rem;
}

.footer-lang {
  font-size: 1.2rem;
  opacity: 0.6;
  text-decoration: none;
}

.footer-lang.active,
.footer-lang:hover {
  opacity: 1;
}

@media (max-width: 768px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }
}
</style>