---
import { languages } from '../i18n/config.js';

const { lang, t } = Astro.props;

const navItems = [
  { key: 'home', href: `${lang}` },
  { key: 'souk', href: `${lang}/shop` },
  { key: 'services', href: `${lang}/services` },
  { key: 'events', href: `${lang}/events` },
  { key: 'freedom', href: `${lang}#space-1` },
  { key: 'codeOfConduct', href: `${lang}/code-of-conduct` },
  { key: 'privacy', href: `${lang}/privacy` },
  { key: 'contact', href: `${lang}/contact` },
];

// Donate dropdown options
const donateOptions = {
  popular: [
    { key: 'donateOnce', label: t.nav.donateOnce || 'Spende machen' },
    { key: 'donateInName', label: t.nav.donateInName || 'In jemandes Namen spenden' },
    { key: 'donateMonthly', label: t.nav.donateMonthly || 'Monatlicher Beitrag' },
    { key: 'becomeMember', label: t.nav.becomeMember || 'Mitglied werden' },
    { key: 'becomePartner', label: t.nav.becomePartner || 'Partner werden' },
  ],
  more: [
    { key: 'donateGift', label: t.nav.donateGift || 'Spenden statt Geschenke' },
    { key: 'legacy', label: t.nav.legacy || 'Vermächtnis / Testament' },
    { key: 'goodsDonation', label: t.nav.goodsDonation || 'Sachspenden' },
    { key: 'corporatePartner', label: t.nav.corporatePartner || 'Unternehmens-Partnerschaft' },
  ],
};
---

<header class="site-header">
  <div class="container header-inner">
    <button class="nav-toggle" aria-label="Toggle navigation" id="navToggle">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a href={`/${lang}`} class="logo">
      <img src="/images/wwfp-logo.png" alt="WWFP Logo" class="logo-img" />
      <span class="logo-text">WWFP</span>
    </a>

    <nav class="site-nav" id="siteNav">
      {navItems.map(item => (
        <a href={`/${item.href}`} class="nav-link">{t.nav[item.key] || item.key}</a>
      ))}

      <div class="nav-actions">
        <a href={`/${lang}/gifts`} class="nav-btn nav-btn-gifts">
          🎁 <span>{t.nav.gifts || 'Gifts'}</span>
        </a>

        <div class="donate-dropdown">
          <button class="nav-btn nav-btn-donate" id="donateBtn">
            💙 <span>{t.nav.donate || 'Donate'}</span> ▾
          </button>
          <div class="donate-menu" id="donateMenu">
            <div class="donate-section">
              <div class="donate-section-title">{t.nav.donatePopular || 'Beliebte Wege zu helfen'}</div>
              {donateOptions.popular.map(opt => (
                <a href={`/${lang}/support#${opt.key}`} class="donate-link">{opt.label}</a>
              ))}
            </div>
            <div class="donate-section">
              <div class="donate-section-title">{t.nav.donateMore || 'Weitere Möglichkeiten'}</div>
              {donateOptions.more.map(opt => (
                <a href={`/${lang}/support#${opt.key}`} class="donate-link">{opt.label}</a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="lang-switcher">
        <button class="lang-btn" id="langBtn">
          {languages[lang].flag} {languages[lang].name} ▾
        </button>
        <div class="lang-dropdown" id="langDropdown">
          {Object.values(languages).map(l => (
            <a href={`/${l.code}`} class={l.code === lang ? 'lang-option active' : 'lang-option'}>
              {l.flag} {l.name}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <div class="lang-switcher lang-switcher-mobile">
      <button class="lang-btn" id="langBtnMobile">
        {languages[lang].flag} ▾
      </button>
      <div class="lang-dropdown" id="langDropdownMobile">
        {Object.values(languages).map(l => (
          <a href={`/${l.code}`} class={l.code === lang ? 'lang-option active' : 'lang-option'}>
            {l.flag} {l.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--color-paper);
  border-bottom: 1px solid var(--color-border);
  box-shadow: 0 1px 4px rgba(45, 32, 19, 0.06);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.8rem 2rem;
  position: relative;
  min-height: 64px;
  width: 100%;
  max-width: 100%;
}

/* Logo — far left */
.logo {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  text-decoration: none;
  position: relative;
  margin-right: auto;
}

.logo-img {
  height: 44px;
  width: auto;
}

.logo-text {
  font-family: var(--font-head);
  font-size: 1.4rem;
  font-weight: bold;
  color: #8ba888;
}

/* Desktop nav — right side, next to actions */
.site-nav {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 1.2rem;
  margin-left: auto;
}

.nav-link {
  font-size: 0.9rem;
  color: var(--color-text);
  text-decoration: none;
  transition: color var(--transition);
  white-space: nowrap;
}

.nav-link:hover {
  color: var(--color-forest);
}

/* Desktop language switcher — right side */
.lang-switcher {
  position: relative;
  position: relative;
}

/* Nav action buttons — Gifts & Donate */
.nav-actions {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-left: 0.5rem;
}

.nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.85rem;
  font-weight: 600;
  padding: 0.45rem 0.9rem;
  border-radius: var(--radius);
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: all var(--transition);
  white-space: nowrap;
}

.nav-btn-gifts {
  background: #1a3a2a;
  color: #c8d8c0;
}

.nav-btn-gifts:hover {
  background: #2a5a3a;
  color: #fff;
}

.nav-btn-donate {
  background: #2d6a4f;
  color: #fff;
}

.nav-btn-donate:hover {
  background: #408060;
}

/* Donate dropdown */
.donate-dropdown {
  position: relative;
}

.donate-menu {
  display: none;
  position: absolute;
  top: 100%;
  right: 0;
  background: var(--color-paper);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
  min-width: 280px;
  padding: 0.6rem 0;
  margin-top: 0.4rem;
  z-index: 102;
}

.donate-menu.open {
  display: block;
}

.donate-section {
  padding: 0.4rem 0;
}

.donate-section:not(:last-child) {
  border-bottom: 1px solid var(--color-border);
}

.donate-section-title {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--color-text-muted, #888);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 0.4rem 1.2rem;
}

.donate-link {
  display: block;
  padding: 0.5rem 1.2rem;
  font-size: 0.85rem;
  color: var(--color-text);
  text-decoration: none;
  transition: background var(--transition);
}

.donate-link:hover {
  background: var(--color-bg-alt, #f5f5f0);
  color: var(--color-forest);
}

.lang-switcher-mobile {
  display: none;
}

.lang-btn {
  background: none;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 0.4rem 0.8rem;
  font-size: 0.85rem;
  cursor: pointer;
  color: var(--color-text);
}

.lang-dropdown {
  display: none;
  position: absolute;
  top: 100%;
  right: 0;
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
  min-width: 160px;
  padding: 0.5rem 0;
  margin-top: 0.4rem;
}

.lang-dropdown.open {
  display: flex;
  flex-direction: column;
}

.lang-option {
  padding: 0.5rem 1rem;
  font-size: 0.85rem;
  color: var(--color-text);
  text-decoration: none;
}

.lang-option:hover {
  background: var(--color-bg-alt);
}

.lang-option.active {
  font-weight: 600;
  color: var(--color-forest);
}

/* Hamburger — hidden on desktop */
.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 4px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.5rem;
}

.nav-toggle span {
  width: 24px;
  height: 2px;
  background: #c8d8c0;
  border-radius: 2px;
}

@media (max-width: 900px) {
  .header-inner {
    padding: 0.8rem var(--space-md);
    min-height: 72px;
  }

  /* Hamburger — left side, clearly separated from logo */
  .nav-toggle {
    display: flex;
    position: absolute;
    left: var(--space-sm);
    top: 50%;
    transform: translateY(-50%);
    z-index: 101;
  }

  /* Logo — right of hamburger, not overlapping */
  .logo {
    position: absolute;
    left: 75px;
    top: 50%;
    transform: translateY(-50%);
  }

  /* Mobile language switcher — right side, compact */
  .lang-switcher { display: none; }
  .lang-switcher-mobile {
    display: block;
    position: absolute;
    right: var(--space-sm);
    top: 50%;
    transform: translateY(-50%);
  }

  /* Mobile nav dropdown — full width below header */
  .site-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-paper);
    flex-direction: column;
    align-items: flex-start;
    padding: 1rem var(--space-md);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow);
  }

  .site-nav.open {
    display: flex;
  }

  .site-nav .nav-link {
    padding: 0.5rem 0;
    font-size: 1rem;
  }

  .nav-actions {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.5rem 0;
    width: 100%;
  }

  .nav-btn {
    width: 100%;
    justify-content: flex-start;
  }

  .donate-menu {
    position: static;
    display: block;
    box-shadow: none;
    border: none;
    min-width: 100%;
    padding: 0.3rem 0 0.3rem 1rem;
  }

  .donate-dropdown {
    width: 100%;
  }
}
</style>

<script>
  document.getElementById('navToggle')?.addEventListener('click', () => {
    document.getElementById('siteNav')?.classList.toggle('open');
  });

  // Desktop lang switcher
  document.getElementById('langBtn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    document.getElementById('langDropdown')?.classList.toggle('open');
  });

  // Mobile lang switcher
  document.getElementById('langBtnMobile')?.addEventListener('click', (e) => {
    e.stopPropagation();
    document.getElementById('langDropdownMobile')?.classList.toggle('open');
  });

  document.addEventListener('click', () => {
    document.getElementById('langDropdown')?.classList.remove('open');
    document.getElementById('langDropdownMobile')?.classList.remove('open');
    document.getElementById('donateMenu')?.classList.remove('open');
  });

  // Donate dropdown
  document.getElementById('donateBtn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    document.getElementById('donateMenu')?.classList.toggle('open');
  });

  // Toggle hidden sections (Souk sections if needed)
  document.querySelectorAll('[data-toggle]').forEach(el => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const key = el.getAttribute('data-toggle');
      const section = document.getElementById(key);
      if (section) {
        const isHidden = !section.classList.contains('section--visible');
        document.querySelectorAll('.section--hidden').forEach(s => s.classList.remove('section--visible'));
        if (isHidden) {
          section.classList.add('section--visible');
          section.scrollIntoView({ behavior: 'smooth' });
        }
      }
    });
  });
</script>